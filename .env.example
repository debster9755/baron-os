# BaronOS runs fully in deterministic demo mode without any variables.

# Optional live AI generation. Server-side only.
GEMINI_API_KEY=

# Optional live market search. Server-side only.
TAVILY_API_KEY=

# Optional production persistence adapter (specified in SPEC.md).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Never expose this value through NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

APP_URL=http://localhost:3000
LOG_LEVEL=info
